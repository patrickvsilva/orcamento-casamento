# =============================================================================
# Orçamento Casamento — variáveis de ambiente
# Copie para .env: cp .env.example .env
# =============================================================================

# -----------------------------------------------------------------------------
# Local (Docker) — desenvolvimento
# -----------------------------------------------------------------------------
# npm run db:up && npm run db:migrate
DATABASE_URL="postgresql://orcamento:orcamento@localhost:5432/orcamento_casamento"

# -----------------------------------------------------------------------------
# Supabase (produção / Vercel / dev remoto)
# Painel: Project Settings → Connect → Transaction pooler (porta 6543)
# IMPORTANTE: use o host/região exatos do seu projeto (ex.: aws-1-us-west-2)
# -----------------------------------------------------------------------------
# DATABASE_URL="postgresql://postgres.kobjvzkbmymcbvdurzjo:[YOUR-PASSWORD]@aws-1-us-west-2.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Conexão direta db.* — só IPv6; não funciona em redes só IPv4. Prefira pooler.
# DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.kobjvzkbmymcbvdurzjo.supabase.co:5432/postgres"
